# Symlinked to ~/.zshrc by bootstrap.sh — edit here, changes show up in git.

# Static copy of `brew shellenv`, which forks brew and path_helper on every shell.
export HOMEBREW_PREFIX="/opt/homebrew" HOMEBREW_CELLAR="/opt/homebrew/Cellar" HOMEBREW_REPOSITORY="/opt/homebrew"
path=(/opt/homebrew/bin /opt/homebrew/sbin ${path:#/opt/homebrew/(s|)bin})
fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"

# --------------------------------------------------------------------------
# oh-my-zsh
# --------------------------------------------------------------------------
export ZSH=$HOME/.oh-my-zsh
ZSH_THEME="morley-new"
plugins=(git)
ZSH_DISABLE_COMPFIX=true
source $ZSH/oh-my-zsh.sh

# git status in the prompt (used by the morley-new theme)
source ~/.zsh/git-prompt.zsh

# --------------------------------------------------------------------------
# nvm + auto-switch to the version in .nvmrc on cd
# --------------------------------------------------------------------------
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# Sourcing nvm.sh costs ~500ms, so it loads on the first `nvm` call.
nvm() {
	unfunction nvm
	\. "/opt/homebrew/opt/nvm/nvm.sh" --no-use
	nvm "$@"
}

# Resolves an nvm version or alias (v22, lts/*, default) to an installed bin dir.
_nvm_bin_for() {
	local spec=$1 depth
	for depth in 1 2 3 4; do
		[[ -f $NVM_DIR/alias/$spec ]] || break
		spec=$(<$NVM_DIR/alias/$spec)
	done
	[[ $spec == [0-9]* ]] && spec=v$spec
	local -a dirs=($NVM_DIR/versions/node/$spec(N/) $NVM_DIR/versions/node/$spec.*(N/nOn))
	[[ -n $dirs ]] && REPLY=$dirs[1]/bin
}

_nvm_put_on_path() {
	path=($1 ${path:#$NVM_DIR/versions/node/*})
	export NVM_BIN=$1
}

if [[ $PATH != *$NVM_DIR/versions/node/* ]] && _nvm_bin_for default; then
	_nvm_put_on_path $REPLY
fi

autoload -U add-zsh-hook
load-nvmrc() {
	local dir=$PWD
	while [[ -n $dir && ! -f $dir/.nvmrc ]]; do dir=${dir%/*}; done
	[[ -f $dir/.nvmrc ]] || return
	local spec=${$(<$dir/.nvmrc)//[[:space:]]/}
	if ! _nvm_bin_for $spec; then
		nvm install
		return
	fi
	[[ $REPLY == $NVM_BIN ]] || _nvm_put_on_path $REPLY
}
add-zsh-hook chpwd load-nvmrc
load-nvmrc

# --------------------------------------------------------------------------
# Aliases & functions
# --------------------------------------------------------------------------
alias copy='pbcopy'
alias resource='source ~/.zshrc'
alias maindiff="git diff main -w"
alias f="rg -g '!src/locale'"

notify() {
	osascript -e 'display notification "Done" with title "Command complete"' \
		&& say done
}

# --------------------------------------------------------------------------
# Environment
# --------------------------------------------------------------------------
export RIPGREP_CONFIG_PATH="${HOME}/.ripgreprc"
export GPG_TTY=$TTY
export CLAUDE_CODE_NO_FLICKER=1
# ignore punycode warning
export NODE_OPTIONS=--disable-warning=DEP0040

# --------------------------------------------------------------------------
# PATH
# --------------------------------------------------------------------------
export PATH="/usr/local/go/bin:${PATH}"
export PATH="$HOME/.yarn/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# --------------------------------------------------------------------------
# History & misc
# --------------------------------------------------------------------------
# Only write history when a shell exits, and don't share across live shells
unsetopt inc_append_history
unsetopt share_history

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/opt/homebrew/share/google-cloud-sdk/path.zsh.inc' ]; then . '/opt/homebrew/share/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/opt/homebrew/share/google-cloud-sdk/completion.zsh.inc' ]; then . '/opt/homebrew/share/google-cloud-sdk/completion.zsh.inc'; fi

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

source ~/projects/_worktrees/pg-zsh-completion/scripts/completions.zsh
